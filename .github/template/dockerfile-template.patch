diff --git a/Dockerfile b/Dockerfile
index b364509..9ca522e 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -10,7 +10,13 @@ WORKDIR /build
 COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
 RUN pnpm install --frozen-lockfile
 RUN mkdir -p /runtime-extras/node_modules && \
-    cp -LR node_modules/ws /runtime-extras/node_modules/ws
+    cp -LR node_modules/ws /runtime-extras/node_modules/ws && \
