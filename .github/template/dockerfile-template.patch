@@ -61,6 +67,17 @@ RUN chmod 0755 ./scripts/railway-entrypoint.sh ./scripts/railway-browser-worker-
       /home/node/.config/openclaw \
       /home/node/Documents/Shared/projects
 
+# Template fix: Next.js standalone output tracing can drop lazily-required files
+# (observed with ws/lib/stream.js), which breaks @openclaw/gateway-client at runtime
+# with "Cannot find module './lib/stream'". Repair incomplete traced ws copies from
+# the complete versions captured in the build stage's pnpm store.
+COPY --from=agentos-build --chown=node:node /runtime-extras/pnpm-ws /tmp/pnpm-ws
+RUN for src in /tmp/pnpm-ws/ws@*; do \
+      ver="$(basename "$src")"; \
+      dst="./node_modules/.pnpm/$ver/node_modules/ws"; \
+      if [ -d "$dst" ]; then rm -rf "$dst" && cp -LR "$src/ws" "$dst"; fi; \
+    done; rm -rf /tmp/pnpm-ws
+
 ENV NODE_ENV=production \
     HOSTNAME=0.0.0.0 \
     HOME=/home/node \
